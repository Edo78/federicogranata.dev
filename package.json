    "@11ty/eleventy-img": "^7.0.0",
    "@11ty/eleventy-plugin-rss": "^3.1.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "concurrently": "^9.2.5",
    "decap-server": "^3.11.5",
    "tailwindcss": "^4.3.3"
  },
  "overrides": {
    "brace-expansion": "1.1.21",
