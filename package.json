  "main": "index.js",
  "scripts": {
    "dev": "ELEVENTY_ENV=development tailwindcss -i tailwind.css -o _site/css/style.css && ELEVENTY_ENV=development concurrently \"npx decap-server\" \"tailwindcss -i tailwind.css -o _site/css/style.css --watch\" \"eleventy --serve\"",
    "build": "ELEVENTY_ENV=production tailwindcss -i tailwind.css -o _site/css/style.css --minify && ELEVENTY_ENV=production eleventy",
    "build:css": "tailwindcss -i tailwind.css -o _site/css/style.css --minify",
    "test": "node --test test/*.test.js",
    "check": "npm test && npm run build && node --test test/output-check.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [],
  "author": "",
