---
layout: layouts/base.njk
---
{% set catData = category | getCategoryData %}
{% set related = collections.posts | relatedPosts(page.inputPath, category, tags, 2) %}

<article class="article-shell">
  <header class="article-header">
    <nav class="breadcrumb" aria-label="Percorso">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      {% if catData %}<a href="/{{ catData.slug }}/">{{ catData.name }}</a>{% else %}<span>Articolo</span>{% endif %}
    </nav>

    <p class="eyebrow mt-6">{{ format | formatLabel }}{% if status and status != "current" %} / {{ status | statusLabel }}{% endif %}</p>
    <h1 class="display-title mt-3 text-4xl sm:text-5xl lg:text-6xl text-text-strong">{{ title }}</h1>
    {% if description %}
      <p class="lead-text mt-5 max-w-3xl text-text-soft">{{ description }}</p>
    {% endif %}

    <div class="article-meta mt-6">
      <time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
      <span aria-hidden="true">&middot;</span>
      <span>{{ content | readingTime }} di lettura</span>
      {% if updated %}
        <span aria-hidden="true">&middot;</span>
        <span>Aggiornato <time datetime="{{ updated | isoDate }}">{{ updated | readableDate }}</time></span>
      {% endif %}
      {% if lastVerified %}
        <span aria-hidden="true">&middot;</span>
        <span>Verificato <time datetime="{{ lastVerified | isoDate }}">{{ lastVerified | readableDate }}</time></span>
      {% endif %}
      {% if repository %}
        <span aria-hidden="true">&middot;</span>
        <a href="{{ repository | safeUrl }}" class="meta-link">Repository &nearr;</a>
      {% endif %}
    </div>

    {% if tags | length > 1 %}
      <div class="mt-5 flex flex-wrap gap-x-3 gap-y-1">
        {% for tag in tags %}
          {% if tag !== "post" %}<a href="{{ tag | topicUrl(category) }}" class="topic-label">#{{ tag }}</a>{% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </header>

  {% if cover %}
    <div class="post-cover mt-8 sm:mt-10 overflow-hidden">
      {% image cover, coverAlt or "", "header", true %}
    </div>
  {% endif %}

  {% if status == "archived" %}
    <aside class="editorial-status mt-8" aria-label="Stato editoriale">
      <span class="eyebrow">Archivio</span>
      <p>Questo testo resta online come documento storico. Le informazioni tecniche possono non descrivere più il progetto attuale.</p>
    </aside>
  {% elseif status == "needs-review" %}
    <aside class="editorial-status mt-8" aria-label="Stato editoriale">
      <span class="eyebrow">Da rivedere</span>
      <p>Il contesto resta utile, ma strumenti e dettagli tecnici potrebbero essere cambiati dalla pubblicazione.</p>
    </aside>
  {% endif %}

  <div class="prose prose-lg mt-10 max-w-none">
    {{ content | safe }}
  </div>

  {% if attachment %}
  <div class="mt-8 pt-6 border-t border-border">
    <a href="{{ attachment | safeUrl }}" download class="button-link inline-flex items-center gap-2">
      Scarica {{ attachment | basename }}
    </a>
  </div>
  {% endif %}

  {% if related | length %}
  <section class="related-notes" aria-labelledby="related-title">
    <p class="eyebrow">Continua nell'archivio</p>
    <h2 id="related-title" class="section-title mt-2">Altre note</h2>
    <div class="related-grid mt-5">
      {% for relatedPost in related %}
      {% set relatedCategory = relatedPost.data.category | getCategoryData %}
      <article class="related-note card-surface">
        <p class="card-meta">
          {% if relatedCategory %}<span>{{ relatedCategory.name }}</span><span class="meta-dot">&middot;</span>{% endif %}
          <span>{{ relatedPost.templateContent | readingTime }}</span>
        </p>
        <h3 class="display-title mt-3 text-2xl text-text-strong"><a href="{{ relatedPost.url }}" class="story-link card-link">{{ relatedPost.data.title }}</a></h3>
        <p class="mt-3 text-sm leading-relaxed text-text-soft">{{ relatedPost.data.description }}</p>
      </article>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% include "partials/author-sig.njk" %}
  {% include "partials/jsonld.njk" %}
</article>
